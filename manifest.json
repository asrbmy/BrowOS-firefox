{
	"manifest_version": 3,
	"name": "BrowOS",
	"version": "1.0.0",
	"description": "Turns your new tab into a desktop OS with windows, a Start menu, a taskbar, built-in apps, BrowStore and custom wallpapers.",
	"icons": {
		"16": "icons/browos-logo.png",
		"32": "icons/browos-logo.png",
		"48": "icons/browos-logo.png",
		"128": "icons/browos-logo.png"
	},
	"chrome_url_overrides": {
		"newtab": "index.html"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "browos@browos.pages.dev",
			"strict_min_version": "140.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	}
}
